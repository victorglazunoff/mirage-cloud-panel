# Mirage Cloud Panel — настройки сервера / server settings
#
# Скопируйте файл в .env в корне панели и раскомментируйте нужное. Всё необязательно:
# без .env панель слушает 127.0.0.1:3001, хранит данные в ~/.mirage, а Telegram,
# Google Calendar, SpeechKit и счётчик лимитов выключены.
# Copy to .env in the panel folder and uncomment what you need. Everything is optional.
#
# Формат: одна переменная на строку, KEY=value, без кавычек и без комментариев в той же строке.
# Format: one KEY=value per line, no quotes, no trailing comments.
# Где панель ищет этот файл и что она видит — `mirage status`.

# =============================================================================
# СЕРВЕР / SERVER
# =============================================================================

# Порт API и WebSocket. / API + WebSocket port.
SERVER_PORT=3001
# Старое имя SERVER_PORT, читается, если SERVER_PORT не задан. / Legacy alias.
# PORT=3001

# Адрес, который слушает сервер. По умолчанию только эта машина (127.0.0.1): открытая
# в сеть панель без пользователя отдаёт создание владельца первому посетителю.
# 0.0.0.0 — все интерфейсы (контейнер, доступ из локальной сети).
# Bind address. Loopback by default; 0.0.0.0 listens on every interface.
HOST=127.0.0.1

# Порт dev-сервера Vite (npm run dev). / Vite dev server port.
# VITE_PORT=5173

# Кому верить в X-Forwarded-For (адрес клиента для списка входов и блокировки подбора).
# Не задано / loopback — только прокси на этой же машине (Caddy, nginx на localhost);
# true — любому пиру (только если порт панели виден одному прокси);
# false — никогда; список адресов или CIDR через запятую — только этим прокси.
# Which reverse proxies may set the client address: loopback (default) | true | false | list of IPs/CIDRs.
# TRUST_PROXY=10.0.0.5,10.0.1.0/24

# Внешний адрес панели: ссылки в сообщениях Telegram. / Public URL used in Telegram links.
# MIRAGE_PANEL_PUBLIC_URL=https://panel.example.com

# =============================================================================
# ДАННЫЕ / DATA
# =============================================================================

# Папка данных: база, вложения чата, артефакты, плагины, профили браузера.
# По умолчанию ~/.mirage. При первом запуске, если её нет, а есть ~/.cloudcli или
# ~/.claude-code-ui (оригинальный CloudCLI UI), их содержимое КОПИРУЕТСЯ сюда; старые не удаляются.
# Data folder (default ~/.mirage); CloudCLI UI folders are copied in on the first start.
# MIRAGE_DATA_DIR=/var/lib/mirage

# Файл базы SQLite (пользователь, сессии, настройки). По умолчанию MIRAGE_DATA_DIR/auth.db.
# SQLite database file. Default: <data folder>/auth.db.
# DATABASE_PATH=/var/lib/mirage/auth.db

# Копии артефактов Claude. По умолчанию artifacts/ рядом с базой. / Artifact copies folder.
# MIRAGE_ARTIFACTS_DIR=/var/lib/mirage/artifacts

# Корень рабочей области: проекты и файлы — только внутри него. По умолчанию домашняя папка.
# Workspace root: projects and the file browser stay inside it. Default: the home folder.
# WORKSPACES_ROOT=/home/me

# =============================================================================
# ВХОД И API / AUTH & API
# =============================================================================

# Секрет подписи JWT. Не задан — создаётся при первом запуске и хранится в базе.
# JWT signing secret; generated and kept in the database when unset.
# JWT_SECRET=

# Необязательный ключ для внешнего API (заголовок x-api-key). / Optional x-api-key for the external API.
# API_KEY=

# =============================================================================
# ВРЕМЯ / TIME
# =============================================================================

# Часовой пояс панели (IANA): часы, календарь, напоминания. По умолчанию — пояс сервера.
# Panel time zone (IANA). Default: the server's own zone.
# MIRAGE_TIMEZONE=Europe/Moscow

# Подпись к времени («14:32 МСК»). Не задана — смещение вида UTC+3.
# Caption after times. Default: the UTC offset.
# MIRAGE_TIMEZONE_LABEL=МСК

# =============================================================================
# CLAUDE CODE И ДРУГИЕ АГЕНТЫ / CLAUDE CODE & OTHER AGENTS
# =============================================================================

# Путь к CLI Claude Code, если это не `claude` из PATH. / Custom Claude Code CLI path.
# CLAUDE_CLI_PATH=claude

# Папка настроек Claude Code (по умолчанию ~/.claude). / Claude Code config folder.
# CLAUDE_CONFIG_DIR=/home/me/.claude

# Вход в Claude без `claude login`: токен подписки или ключ API (передаются CLI как есть).
# Claude sign-in without `claude login`: OAuth token or API key, passed to the CLI.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=

# Окно контекста по умолчанию, пока модель не сообщила своё (токены). / Fallback context window.
# CONTEXT_WINDOW=160000

# Сколько минут фоновая работа живёт после хода (меняется и в настройках панели).
# Minutes background work may run after a turn (also set from the settings screen).
# CLAUDE_SESSION_IDLE_TIMEOUT_MIN=30

# Сколько ждать ответа на запрос разрешения инструмента, мс. / Tool approval timeout, ms.
# CLAUDE_TOOL_APPROVAL_TIMEOUT_MS=55000

# Признаки песочницы: под root Claude Code разрешает Bypass только с ними.
# Sandbox markers: as root Claude Code allows Bypass only with one of them.
# IS_SANDBOX=1
# CLAUDE_CODE_BUBBLEWRAP=1

# Codex и OpenCode (если используются). / Codex and OpenCode, when used.
# OPENAI_API_KEY=
# CODEX_HOME=/home/me/.codex
# OPENCODE_CONFIG=
# OPENCODE_CONFIG_CONTENT=
# OPENCODE_PERMISSION=

# Параллельных операций с файлами в дереве файлов. / File tree I/O concurrency.
# FS_CONCURRENCY=64

# =============================================================================
# СЧЁТЧИК ЛИМИТОВ ПОДПИСКИ / SUBSCRIPTION LIMITS
# =============================================================================

# 1 — показывать недельный лимит и кредиты подписки Claude (приборная строка, главный,
# уведомление «80 %»). Читает OAuth-токен Claude Code из ~/.claude/.credentials.json и
# обращается к НЕОФИЦИАЛЬНОМУ /api/oauth/usage: может перестать работать в любой момент.
# 1 shows Claude subscription limits; uses an unofficial endpoint. Off by default.
# MIRAGE_SUBSCRIPTION_LIMITS=1

# =============================================================================
# TELEGRAM (выключен без токена / off without a token)
# =============================================================================

# Токен бота от @BotFather. / Bot token.
# MIRAGE_TELEGRAM_BOT_TOKEN=
# 1 — бот сам опрашивает Telegram (кнопки, привязка чата). / 1 enables long polling.
# MIRAGE_TELEGRAM_POLLING=1
# Чат по умолчанию, пока чат не привязан из настроек. / Fallback chat id.
# MIRAGE_TELEGRAM_CHAT_ID=

# =============================================================================
# GOOGLE CALENDAR (выключен, пока не заданы оба / off until both are set)
# =============================================================================

# JSON-ключ сервисного аккаунта Google; календарь нужно расшарить на его e-mail.
# Service account key file; share the calendar with the account's e-mail.
# MIRAGE_GOOGLE_CREDENTIALS=/etc/mirage/google-service-account.json
# ID календаря (e-mail владельца или ...@group.calendar.google.com). / Calendar id.
# MIRAGE_GOOGLE_CALENDAR_ID=team@example.com
# off — выключить синхронизацию, даже если всё задано. / off disables the sync.
# MIRAGE_GOOGLE_SYNC=off
# Интервал опроса, секунд (не меньше 30, по умолчанию 120). / Poll interval, s.
# MIRAGE_GOOGLE_SYNC_INTERVAL_SEC=120
# Отправлять в Google только события с таким началом названия (тестовые стенды).
# Push only panel events whose title starts with this (test stands).
# MIRAGE_GOOGLE_PUSH_ONLY_PREFIX=
# Пользователь панели, чьи события синхронизируются (по умолчанию первый). / Synced user id.
# MIRAGE_GOOGLE_USER_ID=1

# =============================================================================
# ГОЛОС / VOICE
# =============================================================================

# Yandex SpeechKit (распознавание русской речи). Без ключа голосовой ввод выключен.
# Yandex SpeechKit speech-to-text; voice input is off without a key.
# YANDEX_SPEECHKIT_API_KEY=
# или файл, первая строка которого — ключ (перечитывается без перезапуска). / or a key file.
# YANDEX_SPEECHKIT_API_KEY_FILE=/etc/mirage/speechkit.key

# Совместимый с OpenAI сервер распознавания и озвучки (Whisper/TTS).
# OpenAI-compatible STT/TTS backend.
# VOICE_API_BASE_URL=https://api.openai.com/v1
# VOICE_API_KEY=
# VOICE_STT_MODEL=whisper-1
# VOICE_TTS_MODEL=tts-1
# VOICE_TTS_VOICE=alloy
# VOICE_TIMEOUT_MS=300000

# =============================================================================
# БРАУЗЕР ДЛЯ АГЕНТОВ / BROWSER USE
# Старые имена CLOUDCLI_BROWSER_USE_* тоже читаются. / Legacy CLOUDCLI_* names still work.
# =============================================================================

# MIRAGE_BROWSER_USE_MAX_SESSIONS_PER_OWNER=3
# MIRAGE_BROWSER_USE_SESSION_TTL_MS=1800000
# MIRAGE_BROWSER_USE_INSTALL_TIMEOUT_MS=600000
# MIRAGE_BROWSER_USE_API_TIMEOUT_MS=60000
